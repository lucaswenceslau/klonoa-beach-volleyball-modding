# ==============================================================================
# Klonoa Beach Volleyball Modding - Configurações de Ambiente (Template)
# Copie este arquivo para .env e NUNCA comite o .env preenchido no Git.
# ==============================================================================

# Caminho para o executável do DuckStation (opcional se estiver em tools/duckstation)
DUCKSTATION_PATH=tools/duckstation/DuckStation-x64.AppImage

# Caminho da ISO original (.bin) para scripts de extração locais (NÃO COMMITADA)
GAME_ISO_PATH=extracted/disc/klonoa_beach_volleyball.bin

# Diretório de dump do DuckStation no seu sistema local:
# Linux: ~/.local/share/duckstation/dump/textures/
# Windows: %USERPROFILE%/Documents/DuckStation/dump/textures/
DUCKSTATION_DUMP_DIR=
